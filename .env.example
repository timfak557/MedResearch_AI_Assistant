# ── LLM (OpenAI-compatible API) ────────────────────────────────────────────
# Never commit real keys. Copy this file to .env and fill in values.
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Embeddings ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medquad_documents

# ── Dataset ────────────────────────────────────────────────────────────────
MEDQUAD_REPOSITORY=https://github.com/abachaa/MedQuAD.git
MEDQUAD_DATA_PATH=data/raw/MedQuAD
PROCESSED_DATA_PATH=data/processed/medquad.jsonl
CHUNKS_DATA_PATH=data/processed/medquad_chunks.jsonl

# ── Retrieval ──────────────────────────────────────────────────────────────
TOP_K=10
FINAL_CONTEXT_K=5
MIN_RELEVANCE_SCORE=0.45
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── App ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_QUERY_LENGTH=2000
MAX_TOP_K=20
CONVERSATION_MAX_TURNS=10
